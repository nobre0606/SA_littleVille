# Copie para .env e preencha. O .env real NUNCA vai para o git (ver .gitignore da raiz).

# Conexão com o PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha@localhost:5432/little_ville?schema=public"

# Porta da API (a 5432 é do banco).
PORT=3333

# Segredo que assina o JWT da sessão. Gere um valor aleatório longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Origem do front autorizada no CORS (com cookies).
CORS_ORIGIN=http://localhost:5173

# development | production (em produção: cookie Secure e erros sem detalhes internos)
NODE_ENV=development
