# Copie para .env se quiser mudar o padrão (o .env real nunca entra no git — ver .gitignore).
#
# VITE_USE_MOCK
#   true  = servidor simulado (MSW) no navegador, com dados de Florianópolis. Não precisa de API.
#   false = chama a API real em VITE_API_URL.
#   Se não definir: mock LIGADO no `npm run dev` e DESLIGADO no `npm run build` (produção).
#   Painel de debug do mock: acrescente ?debug=1 à URL.
VITE_USE_MOCK=true

# Base da API. Em produção, "/api" (a Vercel repassa para a API real — ver vercel.json, Fase 5).
VITE_API_URL=/api
